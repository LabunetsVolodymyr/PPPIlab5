# Normalize line endings for all text files
* text=auto eol=lf

# Python source files
*.py text diff=python

# Configuration and documentation
*.md text
*.txt text
*.csv text
*.json text
*.yml text
*.yaml text
*.ini text
*.cfg text

# Notebooks
*.ipynb text

# Binary files (не порівнювати при diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.zip binary
*.rar binary
*.7z binary

# IDE / editor files
*.iml text
*.bat text eol=crlf
*.sh text eol=lf

# Keep data files consistent
*.csv text eol=lf
